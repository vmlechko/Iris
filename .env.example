# Relayer account. Pays gas for claims and for gasless commitment creation, so
# neither side of Iris needs to hold anything.
#
# On a deployment this is a hot wallet: anything the server can sign, the
# internet can ask it to sign. Use a key that exists only for that, fund it
# modestly, and top it up rather than parking a balance there.
SPONSOR_PK=

# Optional. Defaults to https://testnet-rpc.monad.xyz
MONAD_RPC_URL=

# Optional. Defaults to the address in lib/iris.ts
NEXT_PUBLIC_IRIS_ADDRESS=

# Optional. Defaults to the address in lib/settle.ts — the Agora Instant
# Settlement helper the claim screen offers.
NEXT_PUBLIC_IRIS_SETTLE=

# The Envio indexer the app reads history and names from. Envio's dev
# deployments expire, so this is set per deployment rather than hardcoded.
NEXT_PUBLIC_INDEXER_URL=
